{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibepollo.local/schemas/themes.schema.json",
  "title": "Vibepollo Theme Store",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "currentThemeId", "themes"],
  "properties": {
    "version": { "const": 1 },
    "currentThemeId": { "$ref": "#/$defs/id" },
    "themes": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/theme" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$" },
    "color": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
    "source": { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f]*$" },
    "background": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "source"], "properties": { "type": { "const": "none" }, "source": { "const": "" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "source"], "properties": { "type": { "enum": ["image", "video"] }, "source": { "allOf": [{ "$ref": "#/$defs/source" }, { "minLength": 1 }] } } }
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "palette", "layout", "background"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "fontId": { "$ref": "#/$defs/id" },
        "palette": {
          "type": "object", "additionalProperties": false,
          "required": ["background", "surface", "accent", "text", "mutedText"],
          "properties": {
            "background": { "$ref": "#/$defs/color" }, "surface": { "$ref": "#/$defs/color" },
            "accent": { "$ref": "#/$defs/color" }, "text": { "$ref": "#/$defs/color" }, "mutedText": { "$ref": "#/$defs/color" }
          }
        },
        "layout": {
          "type": "object", "additionalProperties": false, "required": ["showHeroCard"],
          "properties": { "showHeroCard": { "type": "boolean" }, "showClock": { "type": "boolean" }, "showDate": { "type": "boolean" }, "compactCards": { "type": "boolean" }, "reduceMotion": { "type": "boolean" } }
        },
        "background": { "$ref": "#/$defs/background" },
        "sounds": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "volume"],
          "properties": { "enabled": { "type": "boolean" }, "volume": { "type": "number", "minimum": 0, "maximum": 1 }, "focus": { "$ref": "#/$defs/source" }, "confirm": { "$ref": "#/$defs/source" }, "back": { "$ref": "#/$defs/source" } }
        },
        "extensions": { "type": "object", "maxProperties": 32, "propertyNames": { "pattern": "^[a-zA-Z0-9_-]{1,64}$" }, "additionalProperties": { "type": ["string", "number", "boolean", "null"], "maxLength": 1024 } }
      }
    }
  }
}
